class Solution {
    public int longestConsecutive(int[] nums) {
        int n = nums.length;
        if( n == 0) return 0;

        int longest = 1;
        HashSet <Integer> set = new HashSet<>();

        for(int num : nums){
            set.add(num);
        }

        for(int num : set){
            if(!set.contains(num - 1)){
                int currentnum = num;
                int count = 1;

                while(set.contains(currentnum + 1)){
                    currentnum++;
                    count++;
                }
                longest = Math.max(longest, count);
            }
        }
        return longest;
    }
}
